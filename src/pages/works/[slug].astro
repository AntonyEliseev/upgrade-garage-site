---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import Crumbs from '../../components/Crumbs.astro';
import CaseCard from '../../components/CaseCard.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Gallery from '../../components/Gallery.astro';
import casesJson from '@data/cases.json';
import { DIR_NAME, cases, caseBySlug, services, telegram, type Case } from '../../lib/data';
import { breadcrumbs } from '../../lib/schema';

type Detail = (typeof casesJson.cases)['bmw-g60'];
const details = casesJson.cases as Record<string, Detail>;
const filterService = casesJson.filterService as Record<string, string>;

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

interface Props { c: Case }
const { c } = Astro.props;
const d = details[c.slug];
const dir = c.d;
const title = d?.title ?? c.name;
const tags = d?.tags ?? c.tags;
const cover = d?.cover ?? (c.img ? { img: c.img, alt: `${c.name}: ${c.photo.toLowerCase()}` } : null);
const serviceLinks = [...new Set(c.s.map((id) => filterService[id]).filter(Boolean))]
  .map((url) => services.find((s) => s.url === url))
  .filter((s): s is NonNullable<typeof s> => !!s);
const facts: { k: string; v: string; accent?: boolean }[] = d?.facts ?? [
  { k: 'Направление', v: DIR_NAME[dir], accent: true },
  { k: 'Работы', v: c.tags.join(', ') },
  { k: 'Стоимость', v: 'по запросу' },
];
const similarSlugs = d?.similar ?? cases.filter((x) => x.slug !== c.slug && x.img && x.s.some((s) => c.s.includes(s))).slice(0, 3).map((x) => x.slug);
const similar = similarSlugs.map(caseBySlug).filter((x): x is Case => !!x);
const calcHref = url(`/calculator${d?.calc ? `?${d.calc}` : ''}`);
const description = `${c.name}: ${c.tags.join(', ').toLowerCase()}. Фото работы студии ${DIR_NAME[dir]} на Алтуфьевском ш. Позвоните — посчитаем то же для вашей машины.`;
---
<Base
  title={`${title} — кейс студии ${DIR_NAME[dir]}`}
  description={description}
  ogImage={cover?.img}
  current="works"
  dir={dir}
  jsonLd={[breadcrumbs(Astro.site!, [{ name: 'Работы', href: '/works' }, { name: d?.crumb ?? c.name, href: `/works/${c.slug}` }])]}
>
  <div class={`dir-${dir}`}>
    <section class:list={['cover', !cover && 'cover--empty']} data-name="CaseCover">
      {cover && <Photo src={cover.img} alt={cover.alt} sizes="100vw" widths={[480, 800, 1200, 1600, 2000]} eager class="cover__img" />}
      <span class="cover__shade" aria-hidden="true"></span>
      <div class="container cover__in">
        <Crumbs items={[{ name: 'Работы', href: url('/works') }, { name: d?.crumb ?? c.name }]} class="cover__crumbs" />
        <h1 class="cover__title">{title}</h1>
        <div class="tags cover__tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
        {!cover && <p class="cover__nophoto">Фото: {c.photo.toLowerCase()} — скоро добавим. Больше снимков — в <a href={telegram(dir)} target="_blank" rel="noopener">Telegram</a>.</p>}
      </div>
    </section>

    <section class="section section--deep brief" data-name="CaseBrief">
      <div class="container brief__in">
        <div class="stack gap-16">
          <span class="label">{d ? 'С чем пришёл клиент' : 'Что сделали'}</span>
          {d ? <p class="brief__text">{d.brief}</p> : (
            <ul class="brief__list">{c.tags.map((t) => <li>{t}</li>)}</ul>
          )}
          {serviceLinks.length > 0 && (
            <p class="brief__links">Подробнее об услугах: {serviceLinks.map((s, i) => <>{i > 0 && ', '}<a href={url(s.url)}>{s.name.toLowerCase()}</a></>)}</p>
          )}
        </div>
        <dl class="facts" data-name="CaseFacts">
          {facts.map((f) => (
            <div class="facts__row"><dt>{f.k}</dt><dd class:list={[f.accent && 'facts__acc']}>{f.v}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    {d && (
      <section class="section section--deep blocks" data-name="WorkBlocks">
        <div class="container blocks__in">
          {d.blocks.map((b, i) => (
            <div class="block" data-name="WorkBlock">
              <div class="block__text">
                <span class="block__num">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="block__title">{b.title}</h2>
                <p class="block__p">{b.text}</p>
              </div>
              {b.layout === 'before-after' ? (
                <BeforeAfter before={b.photos[0]} after={b.photos[1]} />
              ) : (
                <div class:list={['block__photos', `block__photos--${b.layout}`]}>
                  {b.photos.map((p) => (
                    <span class="block__ph">
                      <Photo src={p.img} alt={p.alt} sizes="(min-width: 1280px) 560px, (min-width: 768px) 50vw, 100vw" />
                      {'caption' in p && p.caption && <span class="case-card__caption">{p.caption}</span>}
                    </span>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {c.photos.length > 0 && (
      <section class="section gallery" data-name="Gallery">
        <div class="container stack gap-32">
          <div class="section-head section-head--row">
            <h2 class="h2">Галерея</h2>
            <span class="small muted">{c.photos.length} фото · все наши, без стока</span>
          </div>
          <Gallery photos={c.photos} name={c.name} />
        </div>
      </section>
    )}

    <section class="section section--deep cta-sec" data-name="CaseCTA">
      <div class="container">
        <div class="cta">
          <span class="acc-line" aria-hidden="true"></span>
          <span class="stack gap-12">
            <span class="cta__title">Хочу так же</span>
            <span class="cta__sub">Посчитаем тот же набор работ для вашей машины</span>
          </span>
          <span class="cta__btns">
            <a href={calcHref} class="btn btn--primary btn--l">Рассчитать такой же набор</a>
            <a href={telegram(dir)} class="btn btn--secondary btn--l" target="_blank" rel="noopener"><Icon name="tgSimple" size={18} />Написать в Telegram</a>
          </span>
        </div>
      </div>
    </section>

    {similar.length > 0 && (
      <section class="section section--deep similar" data-name="SimilarCases">
        <div class="container stack gap-32">
          <h2 class="h2">Похожие работы</h2>
          <div class="similar__grid">
            {similar.map((s) => <CaseCard href={url(`/works/${s.slug}`)} img={s.img} alt={s.name} title={s.name} tags={s.tags.slice(0, 2)} dir={s.d} />)}
          </div>
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .gap-12 { gap: 12px; }
  .gap-16 { gap: 16px; }
  .gap-32 { gap: 20px; }
  @media (min-width: 1280px) { .gap-32 { gap: 32px; } }

  .cover { position: relative; overflow: hidden; min-height: 420px; display: flex; align-items: flex-end; background: var(--ug-bg); }
  .cover--empty { min-height: 320px; background: repeating-linear-gradient(135deg, var(--ug-surface) 0 16px, var(--ug-surface-hover) 16px 32px); }
  .cover :global(.cover__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.72) saturate(0.9); }
  .cover__shade { position: absolute; inset: 0; background: linear-gradient(0deg, var(--ug-bg-deep) 0%, rgba(10, 11, 13, 0.2) 55%, rgba(10, 11, 13, 0.5) 100%); }
  [data-theme='light'] .cover__shade { background: linear-gradient(0deg, var(--ug-bg-deep) 0%, rgba(245, 244, 240, 0.1) 60%); }
  .cover__in { position: relative; z-index: 1; padding-bottom: 32px; display: flex; flex-direction: column; gap: 16px; }
  .cover__in :global(.cover__crumbs), .cover__in :global(.cover__crumbs a) { color: var(--ug-text-2); }
  .cover__title { font-family: var(--ug-font-display); font-size: clamp(32px, calc(32px + 40 * (100vw - 390px) / 1050), 72px); font-weight: 700; line-height: 1.02; letter-spacing: -0.025em; }
  .cover__tags .tag { background: rgba(226, 96, 155, 0.18); min-height: 32px; font-size: 14px; }
  .dir-garage .cover__tags .tag { background: rgba(205, 226, 60, 0.18); }
  .cover__nophoto { font-size: 15px; color: var(--ug-text-2); max-width: 560px; }
  .cover__nophoto a { color: var(--acc-text); text-decoration: underline; }
  @media (min-width: 768px) { .cover { min-height: 520px; } .cover__in { padding-bottom: 48px; gap: 20px; } }
  @media (min-width: 1280px) { .cover { min-height: 640px; } .cover__in { padding-bottom: 64px; } }

  .brief__in { display: flex; flex-direction: column; gap: 24px; }
  .brief__text { font-size: 18px; line-height: 1.5; }
  .brief__list { margin: 0; padding-left: 20px; font-size: 18px; line-height: 1.6; }
  .brief__list li::marker { color: var(--acc); }
  .brief__links { font-size: 15px; color: var(--ug-text-2); }
  .brief__links a { color: var(--acc-text); text-decoration: underline; text-underline-offset: 3px; }
  .facts { margin: 0; padding: 24px; border-radius: 20px; background: var(--ug-surface); border: 1px solid var(--ug-border); display: flex; flex-direction: column; gap: 16px; align-self: start; }
  .facts__row { display: flex; justify-content: space-between; gap: 16px; font-size: 15px; }
  .facts__row dt { color: var(--ug-muted); }
  .facts__row dd { margin: 0; font-weight: 700; text-align: right; }
  .facts__acc { color: var(--acc-text); }
  @media (min-width: 768px) { .brief__text { font-size: 22px; } }
  @media (min-width: 1280px) {
    .brief { padding-block: 88px; }
    .brief__in { display: grid; grid-template-columns: 2fr 1fr; gap: 64px; }
    .brief__text { font-size: 24px; }
    .facts { padding: 28px; }
  }

  .blocks { padding-top: 0; }
  .blocks__in { display: flex; flex-direction: column; gap: 48px; }
  .block { display: flex; flex-direction: column; gap: 20px; }
  .block__text { display: flex; flex-direction: column; gap: 12px; }
  .block__num { font-size: 13px; font-weight: 800; color: var(--acc-text); }
  .block__title { font-family: var(--ug-font-display); font-size: 24px; font-weight: 700; line-height: 1.15; }
  .block__p { font-size: 16px; line-height: 1.55; color: var(--ug-text-2); }
  .block__photos { display: grid; gap: 12px; }
  .block__ph { position: relative; display: block; overflow: hidden; border-radius: 18px; background: var(--ug-bg); aspect-ratio: 4 / 3; }
  .block__ph :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .block__photos--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .block__photos--three .block__ph { aspect-ratio: 3 / 4; }
  .block__photos--big-two { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; }
  .block__photos--big-two .block__ph:first-child { grid-row: span 2; aspect-ratio: auto; min-height: 240px; }
  .block__photos--big-two .block__ph:not(:first-child) { aspect-ratio: auto; }
  @media (min-width: 1280px) {
    .blocks { padding-bottom: 88px; }
    .blocks__in { gap: 72px; }
    .block { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; }
    .block__title { font-size: 30px; }
    .block__photos { gap: 16px; }
    .block__ph { border-radius: 20px; }
    .block__photos--big-two .block__ph:first-child { min-height: 360px; }
    .block__photos--three .block__ph { aspect-ratio: auto; height: 300px; }
  }

  @media (min-width: 1280px) { .gallery { padding-block: 88px; } }

  .cta {
    position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 24px;
    padding: 28px 20px; border-radius: 24px; background: var(--ug-surface); border: 1px solid var(--ug-border);
    --acc-inset: 20px;
  }
  .cta__title { font-family: var(--ug-font-display); font-size: 30px; font-weight: 700; line-height: 1.1; }
  .cta__sub { font-size: 16px; color: var(--ug-text-2); }
  .cta__btns { display: flex; flex-direction: column; gap: 12px; }
  @media (min-width: 768px) { .cta__btns { flex-direction: row; flex-wrap: wrap; } .cta { padding: 40px; --acc-inset: 40px; } }
  @media (min-width: 1280px) {
    .cta-sec { padding-block: 88px; }
    .cta { flex-direction: row; justify-content: space-between; align-items: center; gap: 40px; padding: 56px; border-radius: 28px; --acc-inset: 56px; }
    .cta__title { font-size: 40px; }
    .cta__sub { font-size: 17px; }
    .cta__btns { flex-wrap: nowrap; }
  }
  .cta-sec + .similar { padding-top: 0; }
  .similar__grid { display: grid; gap: 20px; }
  @media (min-width: 768px) { .similar__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; } }
</style>
