---
// Фото из src/assets/img: AVIF/WebP с запасным JPEG, lazy ниже первого экрана.
import { Picture } from 'astro:assets';
import { mustPhoto } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  style?: string;
}
const { src, alt, sizes, widths = [400, 640, 960, 1280], eager, class: cls, style } = Astro.props;
const img = mustPhoto(src);
const w = widths.filter((x) => x <= img.width);
---
<Picture
  src={img}
  alt={alt}
  widths={w.length ? w : [img.width]}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding={eager ? 'sync' : 'async'}
  class={cls}
  style={style}
/>
