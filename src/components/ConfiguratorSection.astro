---
import Configurator, { type TabPhoto, type Thumb } from '../islands/Configurator';
import { photoSrcset } from '../lib/images';
import { contacts, phones } from '../lib/data';
import cfgData from '@data/configurator.json';
import type { TabId } from '../lib/calc';

interface Props {
  mode?: 'embed' | 'page';
  initialTab?: TabId;
  initialFilmPkg?: string;
  /** h1 на странице калькулятора, h2 в остальных местах */
  headingTag?: 'h1' | 'h2';
  heading?: string;
  class?: string;
}
const { mode = 'embed', initialTab, initialFilmPkg, headingTag = 'h2', heading = 'Соберите свою машину', class: cls } = Astro.props;
const H = headingTag;

// Фото вкладок из configurator.json → webp разных размеров через astro:assets
type PhotoData = { src: string; alt: string; caption: string; objectPosition?: string; objectFit?: string };
const rawPhotos = cfgData.photos as Record<TabId, PhotoData>;
const photos = Object.fromEntries(
  await Promise.all(
    (Object.keys(rawPhotos) as TabId[]).map(async (tab) => {
      const p = rawPhotos[tab];
      const set = await photoSrcset(p.src, tab === 'noise' ? [360, 712, 1068, 1424] : [360, 760, 1140, 1520]);
      const photo: TabPhoto = {
        ...set,
        alt: p.alt,
        caption: p.caption,
        position: p.objectPosition ?? '50% 50%',
        fit: p.objectFit === 'contain' ? 'contain' : 'cover',
      };
      return [tab, photo] as const;
    }),
  ),
) as Record<TabId, TabPhoto>;

// Фото-примеры в карточках зон салона: 88×60 (×2 для ретины)
const thumbs = Object.fromEntries(
  await Promise.all(
    Object.entries(cfgData.zoneThumbs as Record<string, { src: string; alt: string }>).map(async ([id, t]) => {
      const set = await photoSrcset(t.src, [176]);
      const thumb: Thumb = { src: set.src, alt: t.alt };
      return [id, thumb] as const;
    }),
  ),
);

const islandProps = { photos, thumbs, phones, hours: contacts.hours.split(',')[0], mode, initialTab, initialFilmPkg };
---
<section id="calc" class:list={['section cfg-section', cls]} data-name="Configurator">
  <div class="container cfg-section__in">
    <div class="cfg-section__head">
      <div class="section-head">
        <span class="label eyebrow cfg-section__eyebrow">Конфигуратор</span>
        <H class="h2">{heading}</H>
      </div>
      <p class="cfg-section__note">Фото — пример модели. Цена считается по типу кузова, который вы выберете<span class="cfg-section__where"> справа</span>.</p>
    </div>
    {mode === 'page'
      ? <Configurator client:load {...islandProps} />
      : <Configurator client:visible={{ rootMargin: '400px' }} {...islandProps} />}
  </div>
</section>

<style>
  .cfg-section__in { display: flex; flex-direction: column; gap: 20px; }
  .cfg-section__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .cfg-section__head .section-head { gap: 14px; }
  .cfg-section__note { max-width: 420px; font-size: 15px; line-height: 1.5; color: var(--ug-muted); }
  .cfg-section__where { display: none; }
  @media (min-width: 1280px) {
    .cfg-section__in { gap: 28px; }
    .cfg-section__where { display: inline; }
  }
  @media (max-width: 767.98px) {
    .cfg-section__in { gap: 16px; }
    .cfg-section__eyebrow, .cfg-section__note { display: none; }
  }
</style>
