---
import Photo from './Photo.astro';
import type { Dir } from '../lib/data';

interface Props {
  href?: string;
  img?: string;
  alt?: string;
  caption?: string;
  badge?: string;
  title: string;
  tags: string[];
  dir: Dir;
  sizes?: string;
  class?: string;
  /** Цветная линия сверху — как в портфолио */
  line?: boolean;
  headingTag?: 'h2' | 'h3';
  /** Сколько фото в кейсе — бейдж «N фото» */
  count?: number;
  /** URL миниатюр 2–4-го фото */
  thumbs?: string[];
}
const { href, img, alt = '', caption, badge, title, tags, dir, sizes = '(min-width: 1280px) 410px, (min-width: 768px) 50vw, 300px', class: cls, line, headingTag = 'h3', count, thumbs = [] } = Astro.props;
const Tag = href ? 'a' : 'div';
const H = headingTag;
---
<Tag href={href} class:list={['case-card', `dir-${dir}`, cls]} data-name="CaseCard">
  <span class:list={['case-card__media', !img && 'case-card__media--stripe']}>
    {img && <Photo src={img} alt={alt} sizes={sizes} />}
    {line && <span class="case-card__line" aria-hidden="true"></span>}
    {badge && <span class="tag tag--photo case-card__badge">{badge}</span>}
    {img && count ? (
      <span class="case-card__count">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="2" /><circle cx="12" cy="13" r="3.5" /><path d="M8 6l2-2h4l2 2" /></svg>
        {count} фото
      </span>
    ) : null}
    {caption && <span class="case-card__caption">{caption}</span>}
    {href && <span class="case-card__cta" aria-hidden="true">Смотреть кейс →</span>}
  </span>
  {thumbs.length > 0 && (
    <span class="case-card__thumbs" aria-hidden="true" data-name="CaseCard/Thumbs">
      {thumbs.map((t) => <span class="case-card__thumb"><img src={t} alt="" loading="lazy" decoding="async" width="76" height="56" /></span>)}
      {count && count > 4 && <span class="case-card__thumb case-card__more">+{count - 4}</span>}
    </span>
  )}
  <H class="case-card__title">{title}</H>
  <span class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</span>
</Tag>

<style>
  .case-card__badge { position: absolute; left: 16px; top: 16px; z-index: 1; }
  @media (min-width: 1280px) { .case-card__badge { left: 20px; top: 20px; } }
</style>
