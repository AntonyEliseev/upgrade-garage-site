---
// Галерея кейса: сетка из всех фото, по клику — лайтбокс со стрелками, свайпом, Esc и счётчиком «3 / 8».
import Photo from './Photo.astro';
import { photoSrcset } from '../lib/images';

interface Props {
  photos: string[];
  /** Название кейса — из него собираются alt: «BMW G60 — фото 3 из 10» */
  name: string;
}
const { photos, name } = Astro.props;
const alt = (i: number) => `${name} — фото ${i + 1} из ${photos.length}`;
// Крупные версии для лайтбокса
const large = await Promise.all(photos.map((p) => photoSrcset(p, [960, 1600, 2200])));
---
<div class="gal" data-gallery>
  <ul role="list" class:list={['gal__grid', `gal__grid--${Math.min(photos.length, 5)}`]}>
    {photos.map((p, i) => (
      <li class:list={['gal__item', i === 0 && photos.length > 2 && 'gal__item--big']}>
        <button
          type="button"
          class="gal__open"
          data-index={i}
          data-src={large[i].src}
          data-srcset={large[i].srcset}
          data-alt={alt(i)}
          aria-label={`Открыть фото ${i + 1} из ${photos.length}`}
        >
          <Photo src={p} alt={alt(i)} sizes={i === 0 ? '(min-width: 1280px) 640px, 100vw' : '(min-width: 1280px) 310px, 50vw'} widths={[320, 480, 640, 960, 1280]} />
        </button>
      </li>
    ))}
  </ul>

  <div class="lb" role="dialog" aria-modal="true" aria-label={`Фото: ${name}`} hidden data-lightbox>
    <div class="lb__top">
      <span class="lb__count" aria-live="polite" data-lb-count>1 / {photos.length}</span>
      <button type="button" class="lb__btn lb__close" aria-label="Закрыть" data-lb-close>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="lb__stage" data-lb-stage>
      <img class="lb__img" alt="" sizes="100vw" data-lb-img />
    </div>
    {photos.length > 1 && (
      <>
        <button type="button" class="lb__btn lb__nav lb__prev" aria-label="Предыдущее фото" data-lb-prev>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="lb__btn lb__nav lb__next" aria-label="Следующее фото" data-lb-next>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </>
    )}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLButtonElement>('.gal__open')];
    const lb = root.querySelector<HTMLElement>('[data-lightbox]')!;
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = lb.querySelector<HTMLElement>('[data-lb-count]')!;
    const stage = lb.querySelector<HTMLElement>('[data-lb-stage]')!;
    const closeBtn = lb.querySelector<HTMLButtonElement>('[data-lb-close]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    // Лайтбокс переносим в body, чтобы position: fixed не зависел от предков
    document.body.appendChild(lb);

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const b = items[index];
      img.srcset = b.dataset.srcset!;
      img.src = b.dataset.src!;
      img.alt = b.dataset.alt!;
      count.textContent = `${index + 1} / ${items.length}`;
      // Соседние фото подгружаем заранее
      [index + 1, index - 1].forEach((j) => {
        const n = items[(j + items.length) % items.length];
        const pre = new Image();
        pre.srcset = n.dataset.srcset!;
        pre.sizes = '100vw';
      });
    };
    const open = (i: number, from: HTMLElement) => {
      opener = from;
      show(i);
      lb.hidden = false;
      document.documentElement.classList.add('lb-open');
      closeBtn.focus();
    };
    const close = () => {
      lb.hidden = true;
      document.documentElement.classList.remove('lb-open');
      opener?.focus();
    };

    items.forEach((b, i) => b.addEventListener('click', () => open(i, b)));
    closeBtn.addEventListener('click', close);
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    // Клик по тёмному полю вокруг фото закрывает
    stage.addEventListener('click', (e) => { if (e.target === stage) close(); });

    lb.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
      else if (e.key === 'Tab') {
        // Фокус не уходит из лайтбокса
        const f = [...lb.querySelectorAll<HTMLElement>('button')];
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    // Свайп влево/вправо
    let x0: number | null = null, y0 = 0;
    stage.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') { x0 = e.clientX; y0 = e.clientY; } });
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      x0 = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
    });
    stage.addEventListener('pointercancel', () => { x0 = null; });
  });
</script>

<style>
  .gal__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .gal__item { position: relative; overflow: hidden; border-radius: 16px; background: var(--ug-bg); aspect-ratio: 1; }
  .gal__item--big { grid-column: span 2; aspect-ratio: 4 / 3; }
  .gal__grid--1 .gal__item { grid-column: span 2; aspect-ratio: 16 / 10; }
  .gal__open { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .gal__open :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease); }
  @media (hover: hover) { .gal__open:hover :global(img) { transform: scale(1.04); } }
  .gal__open:focus-visible { outline-offset: -4px; }
  @media (min-width: 768px) {
    .gal__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 200px; gap: 16px; }
    .gal__item, .gal__item--big { aspect-ratio: auto; border-radius: 20px; }
    .gal__item--big { grid-column: span 2; grid-row: span 2; }
    .gal__grid--1 .gal__item { grid-column: span 4; grid-row: span 2; aspect-ratio: auto; }
    .gal__grid--2 .gal__item { grid-column: span 2; grid-row: span 2; }
  }
  @media (min-width: 1280px) { .gal__grid { grid-auto-rows: 240px; } }

  .lb {
    position: fixed; inset: 0; z-index: 95; display: flex; flex-direction: column;
    background: rgba(5, 6, 8, 0.94); color: #F2F4F7;
  }
  .lb[hidden] { display: none; }
  .lb__top { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; }
  .lb__count { font-size: 15px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .lb__stage { flex: 1 1 auto; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 0 16px 24px; touch-action: pan-y; }
  .lb__img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 12px; user-select: none; -webkit-user-drag: none; }
  .lb__btn {
    width: 48px; height: 48px; border: 0; border-radius: 14px; flex-shrink: 0;
    background: rgba(255, 255, 255, 0.1); color: #F2F4F7;
    display: flex; align-items: center; justify-content: center; transition: background-color var(--t);
  }
  @media (hover: hover) { .lb__btn:hover { background: rgba(255, 255, 255, 0.18); } }
  .lb__btn:focus-visible { outline: 2px solid #F2F4F7; outline-offset: 3px; }
  .lb__nav { position: absolute; top: 50%; margin-top: -24px; }
  .lb__prev { left: 12px; }
  .lb__next { right: 12px; }
  @media (max-width: 767.98px) {
    .lb__nav { top: auto; bottom: calc(16px + env(safe-area-inset-bottom)); margin-top: 0; }
    .lb__stage { padding-bottom: calc(80px + env(safe-area-inset-bottom)); }
  }
  @media (min-width: 768px) { .lb__stage { padding: 0 88px 32px; } .lb__top { padding: 16px 24px; } }
  :global(html.lb-open) { overflow: hidden; }
</style>
